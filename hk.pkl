amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["ktlint"] = Builtins.ktlint
  ["newlines"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace
}

hooks {
  ["pre-commit"] {
    fix = true
    steps = linters
  }
  ["pre-push"] {
    steps = new {
      ["tests"] {
        check = "mise run test:unit"
        exclusive = true
      }
      ["docs-tests"] {
        check = "mise run test:docs"
        glob = new Listing<String> {
          "docs/**/*.md"
          "docs/code/**/*.kt"
        }
        exclusive = true
      }
    }
  }
  ["check"] {
    steps = linters
  }
}
