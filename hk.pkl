amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["ktlint"] = (Builtins.ktlint) {
    // The examples under docs/code/example are generated from the markdown
    // code blocks: their names follow the markdown files, and their content
    // is documentation snippets rather than project code.
    exclude = List("docs/code/example/**")
  }
  ["newlines"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace
}

hooks {
  ["pre-commit"] {
    fix = true
    steps = linters
  }
  ["pre-push"] {
    steps = new {
      ["tests"] {
        check = "mise run test:unit"
        exclusive = true
      }
      ["docs-tests"] {
        check = "mise run test:docs"
        glob = List("docs/**/*.md", "docs/code/**/*.kt")
        exclusive = true
      }
    }
  }
  ["check"] {
    steps = linters
  }
}
