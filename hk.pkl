amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

// The examples under docs/code/example and the tests under docs/code/test are
// generated by Knit from the markdown docs: their names follow the markdown
// files, and their content is documentation snippets rather than project code.
// Editing them breaks the knit check, so every linter skips them.
// (docs/code/test/PrimitiveAliasesTest.kt is hand-written, but it shares the
// generated directory and stays out with it.)
exclude = List("docs/code/example/**", "docs/code/test/**")

// The glob covers the Kotlin sources and the Gradle build scripts: the
// builtin only matches `**/*.kt`.
local ktlint = (Builtins.ktlint) {
  glob = List("**/*.kt", "**/*.kts")
}

local linters = new Mapping<String, Step> {
  ["ktlint"] = ktlint
  ["newlines"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace
}

hooks {
  ["pre-commit"] {
    fix = true
    steps = linters
  }
  ["pre-push"] {
    steps = new {
      // The pre-commit hook fixes the staged files, so a commit made with
      // --no-verify can still carry lint errors. This checks the files the
      // push carries.
      ["ktlint"] = ktlint
      ["tests"] {
        check = "mise run test:unit"
        exclusive = true
      }
      ["docs-tests"] {
        check = "mise run test:docs"
        glob = List("docs/**/*.md", "docs/code/**/*.kt")
        exclusive = true
      }
    }
  }
  ["check"] {
    steps = linters
  }
}
