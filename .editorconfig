root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{kt,kts}]
# ktlint's default style expects four-space indentation and indents Gradle's
# plugins block, which the build scripts cannot use. The IntelliJ style honours
# the two-space indentation above.
ktlint_code_style = intellij_idea
