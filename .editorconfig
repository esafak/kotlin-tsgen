root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{kt,kts}]
# ktlint's default code style expects four-space indentation; the IntelliJ one
# honours the two-space indentation above, which is what the build scripts use.
ktlint_code_style = intellij_idea
